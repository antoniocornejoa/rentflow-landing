# ─────────────────────────────────────────────────────────────────────────────
# RentFlow — Variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# NUNCA subas `.env.local` al repo. Las variables NEXT_PUBLIC_* llegan al navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio raíz de la plataforma ────────────────────────────────────────────
# Tu dominio comercial. En local usa "localhost:3000".
# - midominio.cl            -> sitio comercial
# - app.midominio.cl        -> panel admin + portal cliente
# - {cualquier-otro-host}   -> landing de un tenant
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# SECRETO — solo servidor. Bypassa RLS. Jamás en el navegador ni en NEXT_PUBLIC_*.
# Se usa para: render ISR de landings, ingesta de leads/visitas y crons.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# ── Resend (correos transaccionales) — se usa desde la Fase 5 ────────────────
RESEND_API_KEY=re_...
# Remitente verificado (DKIM/SPF/DMARC) del operador. reply-to = email del cliente.
RESEND_FROM="RentFlow <notificaciones@midominio.cl>"

# ── Anti-spam de formularios (Cloudflare Turnstile) — se usa desde la Fase 5 ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Vercel Edge Config (opcional; optimización de resolución host->tenant) ────
# Si se define, el middleware/resolución puede leer el mapa host->tenant sin BD.
EDGE_CONFIG=

# ── Cron (protege los endpoints /api/cron/*) ─────────────────────────────────
CRON_SECRET=
